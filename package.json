{
  "name": "icestudio",
  "version": "1.0.0.PRw",
  "description": "Visual editor for open FPGA boards",
  "contributors": [
    {
      "name": "Carlos Venegas Arrabe",
      "url": "https://github.com/cavearr"
    },
    {
      "name": "Juan González Gómez",
      "url": "https://github.com/Obijuan"
    }
  ],
  "repository": "https://github.com/FPGAwars/icestudio",
  "license": "GPL-2.0",
  "scripts": {
    "prepare": "npm run setupDevEnv",
    "start": "npm run setupDevEnv && grunt serve",
    "buildLinux64": "grunt dist --platform=linux64",
    "buildAarch64": "grunt dist --platform=aarch64 ",
    "buildWindows": "grunt dist --platform=win64",
    "buildOSX": "grunt dist --platform=darwin",
    "buildOSXARM64": "grunt dist --platform=darwin --cpu=arm64",
    "preptext": "grunt gettext && scripts/update_translations.sh",
    "compiletext": "grunt compiletext",
    "prettier": "prettier --write .",
    "prettierBot": "prettier --write . 2>&1 | tee .git/tmp/prettier-modified.txt",
    "jshint": "grunt jshint",
    "checkData": "node scripts/checkData.js",
    "setupDevEnv": "grunt setupDevEnv",
    "preparePackageJson": "grunt preparePackageJson",
    "clean": "grunt clean",
    "getcollection": "grunt getcollection",
    "debugInfo": "grunt debugInfo",
    "postinstall": "sh scripts/postInstall.sh && grunt getcollection && npmpd && patch-package && cd app && npm install"
  },
  "devDependencies": {
    "grunt": "^1.4.1",
    "grunt-angular-gettext": "^2.5.3",
    "grunt-cli": "^1.4.3",
    "grunt-contrib-clean": "^2.0.0",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-jshint": "^3.1.1",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-exec": "^3.0.0",
    "grunt-json-minify": "^1.1.0",
    "grunt-nw-builder": "^4.0.1",
    "grunt-shell": "^3.0.1",
    "grunt-wget": "^0.1.3",
    "grunt-zip": "^0.18.2",
    "json": "^11.0.0",
    "npm-platform-dependencies": "^0.1.0",
    "nw": "0.111.3-sdk",
    "nw-builder": "4.13.16",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2"
  },
  "darwinDependencies": {
    "fs-xattr": "^0.4.0",
    "grunt-appdmg": "github:agoodney/grunt-appdmg"
  },
  "dependencies": {}
}
