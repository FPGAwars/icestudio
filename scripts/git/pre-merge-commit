#!/bin/bash
# Icestudio data check before a merge commit
# ==========================================
# A merge without conflicts does not run pre-commit. This hook checks the data
# files the merge brings (JSON, boards, plugins, translations), read from the
# index. Installed by `grunt setupDevEnv`.

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
ERROR_ICON="⛔"
SUCCESS_ICON="✅"
WARNING_ICON="⚠️"

box_message() {
    local color=$1
    local icon=$2
    local message=$3

    local length=${#message}
    local border=$(printf '%*s' $((length + 7)) '' | tr ' ' '-')

    echo -e "${color}"
    echo -e "+${border}+"
    echo -e "|  ${icon} ${message}  |"
    echo -e "+${border}+"
    echo -e "${NC}"
}

box_message "\n$YELLOW" "$WARNING_ICON" "Checking merged data files..."
if ! node scripts/checkData.js --staged; then
    box_message "$RED" "$ERROR_ICON" "Data check failed! The merge is not committed: fix the files above and run git commit."
    exit 1
fi
box_message "$GREEN" "$SUCCESS_ICON" "Data files are valid."
exit 0
